{
  "manifest_version": 3,
  "name": "Send to reMarkable (unofficial)",
  "version": "0.1.0",
  "description": "Sends the current page to a reMarkable tablet: PDFs and ePubs as they are, web articles as ePubs.",
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "menus",
    "notifications",
    "scripting",
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "webRequestFilterResponse"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.ts",
    "scripts": ["background.ts"],
    "type": "module"
  },
  "action": {
    "default_title": "Send to reMarkable",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "remarkable-send@piwowarski.fr",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
