{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["firefox-webext-browser"]
	},
	"include": ["source/**/*.ts"]
}
